# THE 3 VARIATIONS FOR OHMS LAW
def ohms_law_current(resistance, voltage): # This function does the ohms law for current
    try:
        resistance = float(resistance)
        voltage = float(voltage)
        return voltage / resistance

    except (ValueError, ZeroDivisionError):
        return None


def ohms_law_resistance(current, voltage): # This function does the ohms law for resistence
    try:
        current = float(current)
        voltage = float(voltage)
        return voltage / current

    except (ValueError, ZeroDivisionError): 
        return None


def ohms_law_voltage(resistance, current): # This function does the ohms law for voltage
    try:
        resistance = float(resistance)
        current = float(current)
        return resistance * current

    except ValueError:
        return None

# POWER EQUATIONS DEPENDING ON THE KNOWNS
def current_resistance_power(current, resistance):
    try:
        current = float(current)
        resistance = float(resistance)
        return current ** 2 * resistance

    except ValueError:
        return None

def current_voltage_power(current, voltage):
    try:
        current = float(current)
        voltage = float(voltage)
        return current * voltage

    except ValueError:
        return None

def voltage_resistance_power(voltage, resistance):
    try:
        voltage = float(voltage)
        resistance = float(resistance)
        return voltage ** 2 / resistance

    except (ValueError, ZeroDivisionError):
        return None

# Equivalent Resistence Equations

def parallel_resistance(r1, r2):
    try:
        r1 = float(r1)
        r2 = float(r2)
        top = r1 * r2
        bottom = r1 + r2
        return top / bottom

    except ValueError:
        return None

def series_resistance(r1, r2):
    try:
        r1 = float(r1)
        r2 = float(r2)
        return r1 + r2

    except ValueError:
        return None

# VOLTAGE DIVISION EQUATION

def voltage_division_eqn(v_source, r, r_eq):
    try:
        v_source = float(v_source)
        r = float(r)
        r_eq = float(r_eq)
        wanted_voltage = v_source * (r / r_eq)
        return wanted_voltage

    except (ValueError, ZeroDivisionError):
        return None

# CURRENT DIVISION EQUATION

def current_division_eqn(i_source, r, r_eq):
    try:
        i_source = float(i_source)
        r = float(r)
        r_eq = float(r_eq)
        wanted_current = i_source * (r_eq / r)
        return wanted_current

    except (ValueError, ZeroDivisionError):
        return None

